# ============================================================
# GroupTrip Ledger - Frontend Environment Configuration
# ============================================================

# AI Chatbot (Groq)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google OAuth 2.0 Client ID (for Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps API Key (optional — roadmap, satellite, terrain tiles load automatically)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# API Base URL (leave empty for Vercel production to use relative /api/v1, or http://127.0.0.1:8000 for local dev)
VITE_API_BASE_URL=
