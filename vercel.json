{
  "version": 2,
  "buildCommand": "cd frontend/frontend && npm install && npm run build",
  "outputDirectory": "frontend/frontend/dist",
  "installCommand": "echo 'Python deps installed per-function from api/requirements.txt'",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
