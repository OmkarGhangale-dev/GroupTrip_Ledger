{
  "version": 2,
  "installCommand": "cd frontend/frontend && npm install",
  "buildCommand": "cd frontend/frontend && npm run build",
  "outputDirectory": "frontend/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "app/**,routers/**,models/**,services/**,schemas/**,utils/**,database/**,*.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
