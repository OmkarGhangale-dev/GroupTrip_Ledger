# =============================================================================
# GroupTrip Ledger - Backend Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# 🗄️ PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Local PostgreSQL:
# Format: postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:your_local_password@localhost:5432/grouptrip_ledger

# Cloud PostgreSQL (Neon / Supabase / Vercel Postgres):
# In production on Vercel, set DATABASE_URL or POSTGRES_URL in Vercel Project Settings:
# Example: postgresql+asyncpg://user:pass@ep-xxxx-pooler.region.neon.tech/neondb
# POSTGRES_URL=

# -----------------------------------------------------------------------------
# 🔐 Application & Authentication Secrets
# -----------------------------------------------------------------------------
# JWT signing key for user sessions. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_strong_random_secret_key_for_production

# CORS: Comma-separated allowed frontend origins.
# Set to "*" for local dev, or your production frontend domain (e.g., https://your-app.vercel.app)
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 🔑 Google OAuth 2.0 Credentials
# -----------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Add authorized JavaScript origins:
# - http://localhost:5173 (for local dev)
# - https://your-app.vercel.app (for production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 🤖 AI Assistant (Groq Cloud API)
# -----------------------------------------------------------------------------
# Obtain a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# (Optional) Google Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 🗺️ Maps API (Optional)
# -----------------------------------------------------------------------------
# Optional Google Maps API key (Leaflet open tiles load by default without a key)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# ⚙️ Application Settings
# -----------------------------------------------------------------------------
APP_NAME=GroupTrip Ledger
APP_VERSION=1.0.0
DEBUG=False
